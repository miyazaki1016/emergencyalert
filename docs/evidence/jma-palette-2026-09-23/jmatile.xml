  <!-- 表示領域定義 -->
  <displayArea>
    <!-- ズームレベル最小値 -->
    <minZoom>4</minZoom>
    <!-- ズームレベル最大値 -->
    <maxZoom>14</maxZoom>
    <!-- ズームレベル単位 -->
    <zoomSnap>1</zoomSnap>
    <!-- ズームレベルデフォルト値 -->
    <defaultZoom>5</defaultZoom>
    <!-- 緯度最小値 -->
    <minLat>7</minLat>
    <!-- 緯度最大値 -->
    <maxLat>61</maxLat>
    <!-- 緯度デフォルト値 -->
    <defaultLat>34</defaultLat>
    <!-- 経度最小値 -->
    <minLon>100</minLon>
    <!-- 経度最大値 -->
    <maxLon>178</maxLon>
    <!-- 経度デフォルト値 -->
    <defaultLon>135</defaultLon>
  </displayArea>
  <!-- モバイル端末用表示領域定義 -->
  <mobileDisplayArea>
    <minZoom>4</minZoom>
    <maxZoom>14</maxZoom>
    <zoomSnap>1</zoomSnap>
    <defaultZoom>4</defaultZoom>
    <minLat>7</minLat>
    <maxLat>61</maxLat>
    <defaultLat>34</defaultLat>
    <minLon>100</minLon>
    <maxLon>178</maxLon>
    <defaultLon>135</defaultLon>
  </mobileDisplayArea>
  <!-- 色の濃さ
       @id{String} 識別子
       @opacity{Number} 不透明度
       [@defaultSelected{Boolean} デフォルト選択フラグ]
         # ラジオボタンのラベルに利用するため
         # /properties/jp|en/notation[@id="label_color_depth_{@id}"]を定義すること -->
  <colorDepth id="thin" opacity="50" />
  <colorDepth id="normal" opacity="75" defaultSelected="true" />
  <colorDepth id="deep" opacity="100" />
  <!-- xyJSON URL
       情報通信基盤課HP整備班が管理する定数ファイル
       area_type(領域種別),area_code(領域コード)に対応する中心位置(xy)が格納されている -->
  <xyJSONUrl>../common/const/xy.json</xyJSONUrl>
