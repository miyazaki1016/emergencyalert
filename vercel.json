{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "node scripts/vercel-build-guard.mjs",
  "rewrites": [
    {
      "source": "/hakone-guide",
      "destination": "/hakone-guide/index.html"
    },
    {
      "source": "/hakone-guide/",
      "destination": "/hakone-guide/index.html"
    }
  ]
}
